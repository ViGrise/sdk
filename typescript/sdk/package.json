{
  "name": "@vigrise/sdk",
  "version": "0.2.0",
  "description": "Official ViGrise SDK for TypeScript and JavaScript: request signing, credentials and clients for ViGrise services",
  "license": "Apache-2.0",
  "homepage": "https://platform.vigrise.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ViGrise/sdk.git",
    "directory": "typescript/sdk"
  },
  "bugs": "https://github.com/ViGrise/sdk/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "import": "./dist/auth/index.js",
      "require": "./dist/cjs/auth/index.js"
    },
    "./auth/browser": {
      "types": "./dist/auth/browser.d.ts",
      "import": "./dist/auth/browser.js",
      "require": "./dist/cjs/auth/browser.js"
    },
    "./accounts/server": {
      "types": "./dist/services/accounts/server/index.d.ts",
      "import": "./dist/services/accounts/server/index.js",
      "require": "./dist/cjs/services/accounts/server/index.js"
    },
    "./speech": {
      "types": "./dist/services/speech/index.d.ts",
      "import": "./dist/services/speech/index.js",
      "require": "./dist/cjs/services/speech/index.js"
    },
    "./storage": {
      "types": "./dist/services/storage/index.d.ts",
      "import": "./dist/services/storage/index.js",
      "require": "./dist/cjs/services/storage/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json', JSON.stringify({type: 'commonjs'}))\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check:package": "node scripts/check-package.cjs",
    "prepublishOnly": "npm run build && npm run check:package"
  },
  "dependencies": {
    "jose": "^5.10.0"
  },
  "devDependencies": {}
}
