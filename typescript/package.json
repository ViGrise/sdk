{
  "name": "@vigrise/auth",
  "version": "0.1.0",
  "description": "VGR4 request signing for calling ViGrise services",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/cjs/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "require": "./dist/cjs/browser.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json', JSON.stringify({type: 'commonjs'}))\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check:package": "node scripts/check-package.cjs",
    "prepublishOnly": "npm run build && npm run check:package"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "module": "./dist/index.js"
}
